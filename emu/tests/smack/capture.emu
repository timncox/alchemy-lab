# Smack: capture what comes in and loop it; the OLED follows the knob being
# turned; leaving Settings with B2 must not punch (Settings-exit fix).
wait 3500
sing 220
wait 3000
hold b1 900                # hold > 0.6 s: capture the last LENGTH steps
wait 600
print leds
expect led b1 green        # looping
silence
wait 1500
mark
wait 500
expect rms > 0.005         # the captured loop plays with silence coming in
pot 1 0.3                  # turn FX
wait 400
expect screen FX
press b3
wait 50
press b2
wait 2300
release b2
release b3
wait 400
tap b2                     # close Settings with B2
wait 100
expect led b1 green        # not white: no punch from the closing press
